{
  "name": "hezamedia-android",
  "version": "1.0.0",
  "private": true,
  "description": "HEZA MEDIA official Android app, powered by Capacitor and the existing Firestore news site",
  "scripts": {
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:assets": "npx capacitor-assets generate --android",
    "preview": "npx http-server www -p 8080"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/assets": "^3.0.5",
    "http-server": "^14.1.1"
  }
}
